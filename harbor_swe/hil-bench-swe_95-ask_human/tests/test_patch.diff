+func (*testBroker) SendMessage(context.Context, events.Event)      {}
+
+type testMediaFolderRepo struct{}
+
+func (testMediaFolderRepo) Get(int32) (*model.MediaFolder, error) { return nil, nil }
+func (testMediaFolderRepo) GetAll() (model.MediaFolders, error) {
