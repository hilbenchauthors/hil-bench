+func (r *chunkSizeRecordingMediaFileRepo) GetAll(options ...model.QueryOptions) (model.MediaFiles, error) {
+	if len(options) > 0 {
+		if eq, ok := options[0].Filters.(squirrel.Eq); ok {
+			if v, ok := eq["album_id"]; ok {
+				if ids, ok := v.([]string); ok {
+					r.ds.albumBatchSizes = append(r.ds.albumBatchSizes, len(ids))
+				}
+			}
+		}
+	}
+	return nil, nil
+}
