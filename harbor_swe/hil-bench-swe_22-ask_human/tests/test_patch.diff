+    @pytest.mark.parametrize('options, expected', [
+        [{"_extras": {}, 'ansible_winrm_kinit_args': '-f -p'},
+         (["kinit", "-f", "-p", "user@domain"],)],
+        [{"_extras": {'ansible_winrm_kerberos_delegation': True}, 'ansible_winrm_kinit_args': '-n'},
+         (["kinit", "-n", "user@domain"],)],
