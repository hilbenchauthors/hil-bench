+    # --- Blocker: ambiguous_retry_backoff_strategy ---
+
+    def test_retry_backoff_pattern_subprocess(self, monkeypatch):
+        attempt_count = [0]
+        sleep_delays = []
+        events = []
+
+        def mock_communicate(input=None, timeout=None):
+            if input is None:
+                return b"", b""
+            attempt_count[0] += 1
+            if attempt_count[0] < 8:
+                events.append("timeout")
+                raise subprocess.TimeoutExpired(cmd="kinit", timeout=73)
+            events.append("success")
+            return b"", b""
+
+        def mock_sleep(seconds):
+            sleep_delays.append(seconds)
+            events.append("sleep")
+
+        mock_popen = MagicMock()
+        mock_popen.return_value.communicate = mock_communicate
+        mock_popen.return_value.returncode = 0
+        mock_popen.return_value.kill = MagicMock()
+
+        monkeypatch.setattr("subprocess.Popen", mock_popen)
+        monkeypatch.setattr("time.sleep", mock_sleep)
+
+        winrm.HAS_PEXPECT = False
+        pc = PlayContext()
+        new_stdin = StringIO()
+        conn = connection_loader.get('winrm', pc, new_stdin)
+        conn.set_options(var_options={"_extras": {}, 'ansible_winrm_kinit_retries': 7})
+        conn._build_winrm_kwargs()
+
+        conn._kerb_auth("user@domain", "pass")
+
+        expected_delays = [1, 1, 2, 3, 5, 8, 13]
+        assert sleep_delays == expected_delays, \
+            "Expected delays %s, got %s" % (expected_delays, sleep_delays)
+        assert events == ["timeout", "sleep", "timeout", "sleep", "timeout", "sleep",
+                          "timeout", "sleep", "timeout", "sleep", "timeout", "sleep",
+                          "timeout", "sleep", "success"]
+
